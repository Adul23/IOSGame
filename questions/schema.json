{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Parkour question set",
  "type": "array", "minItems": 1, "maxItems": 500,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "topic", "difficulty", "question", "answers", "correct", "explanation", "source"],
    "properties": {
      "id": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
      "topic": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
      "difficulty": {"type": "integer", "minimum": 1, "maximum": 3},
      "question": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
      "answers": {"type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"}},
      "correct": {"type": "integer", "minimum": 0, "maximum": 3},
      "explanation": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
      "source": {"type": "string", "format": "uri", "maxLength": 4000, "pattern": "^https?://"}
    }
  }
}
